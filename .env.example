# ── Clerk (authentication) ───────────────────────────────────────────────────
# dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_YOUR-KEY
CLERK_SECRET_KEY=sk_YOUR-KEY
# Auth routes (defaults shown — only needed if you change the paths):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase (database only) — Settings → API Keys ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Secret key — used ONLY server-side (profile bootstrap, user removal, CSV import).
# New format starts with sb_secret_... ; legacy equivalent is the service_role JWT.
SUPABASE_SECRET_KEY=sb_secret_YOUR-KEY

# ── AI assistant ─────────────────────────────────────────────────────────────
# OpenCode Go subscription (https://opencode.ai/auth → subscribe to Go → API key).
# Uses the single model deepseek-v4.1-flash via https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
# Fallbacks (used only if OPENCODE_API_KEY is empty):
# OPENAI_API_KEY=               (https://platform.openai.com/api-keys)
# GOOGLE_GENERATIVE_AI_API_KEY= (https://aistudio.google.com)
# GROQ_API_KEY=                 (https://console.groq.com)
# Optional model override for fallback providers only:
# AI_MODEL=

# ── Research pipeline (optional) ─────────────────────────────────────────────
# Website rendering + search via TinyFish — free on every plan
# (Fetch: ~1,000 URLs/day, Search: ~500/hour). Handles JavaScript-heavy sites and
# finds the LinkedIn company URL when it is not linked on the site.
# Key: https://agent.tinyfish.ai → API Keys. Optional — without it the portal falls
# back to a built-in fetcher and skips the search fallback.
TINYFISH_API_KEY=

# ── Deep research (Apify) ────────────────────────────────────────────────────
# People-search actor runs. Key: https://console.apify.com → Settings → API tokens.
APIFY_API_TOKEN=

# ── Email composer (SMTP) ────────────────────────────────────────────────────
# 32-byte hex key (64 chars) used to encrypt per-member SMTP passwords at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMTP_ENCRYPTION_KEY=
