# Supabase — Settings → API Keys in your project dashboard
# New projects use publishable/secret keys; legacy anon/service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Secret key — used ONLY server-side (CSV import script + invitations). Never expose publicly.
# New format starts with sb_secret_... ; legacy equivalent is the service_role JWT.
SUPABASE_SECRET_KEY=sb_secret_YOUR-KEY

# ── AI assistant ─────────────────────────────────────────────────────────────
# Set ONE of these. Google Gemini has a free tier: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# Optional: override the model id (defaults: gemini-2.5-flash / gpt-4o-mini / llama-3.3-70b-versatile)
# AI_MODEL=
